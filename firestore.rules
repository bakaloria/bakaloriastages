rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.role == 'admin';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Spark mode keeps the free plan usable: the browser writes its own
    // progress. For the hardened Cloud Functions rules, deploy
    // firestore.functions.rules instead.

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        && request.resource.data.role == 'student'
        && request.resource.data.branch in ['scientific', 'literary']
        && request.resource.data.username is string
        && request.resource.data.usernameLower is string;
      allow update: if isOwner(uid)
        && request.resource.data.role == resource.data.role
        && request.resource.data.branch == resource.data.branch;
      allow delete: if false;
    }

    // The client creates its username reservation inside the registration
    // transaction. It may read its own reservation but never edit it.
    match /usernames/{username} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username == username
        && username.matches('^[a-z0-9_]{3,20}$');
      allow update, delete: if false;
    }

    // Catalogue and question bank. The importer uses the Admin SDK, which
    // bypasses these rules.
    match /subjects/{subjectId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /units/{unitId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /lessons/{lessonId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /questions/{questionId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Spark grading runs in the browser, so signed-in students need the answer
    // key. This is the trade-off of the free plan. The callable backend keeps
    // this collection completely private.
    match /question_answers/{questionId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /unit_totals/{unitTotalId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /subject_settings/{subjectId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /settings/{settingsId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Enrollments are readable to signed-in students because the leaderboard
    // is built directly from them. Only the owner can create or update one.
    match /enrollments/{enrollmentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.subjectId is string
        && request.resource.data.coverageCount == 0
        && request.resource.data.masteryCount == 0
        && request.resource.data.autoFirstCorrect == 0
        && request.resource.data.stagesCompleted == 0
        && request.resource.data.stagesInSession == 0
        && request.resource.data.sessionNo == 1
        && request.resource.data.nextQuestionIndex == 0
        && request.resource.data.nextAvailableAt == null
        && request.resource.data.completedAt == null
        && request.resource.data.masteryCompletedAt == null;
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.subjectId == resource.data.subjectId;
      allow delete: if false;
    }

    match /progress/{progressId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.subjectId is string
        && request.resource.data.questionId is string
        && request.resource.data.seenCount == 1;
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.questionId == resource.data.questionId;
      allow delete: if false;
    }

    match /unit_progress/{unitProgressId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.subjectId is string
        && request.resource.data.unitId is string;
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.subjectId == resource.data.subjectId
        && request.resource.data.unitId == resource.data.unitId;
      allow delete: if false;
    }

    match /stage_attempts/{attemptId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.subjectId is string
        && request.resource.data.status == 'in_progress'
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0;
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.subjectId == resource.data.subjectId;
      allow delete: if false;
    }

    match /final_exam_attempts/{attemptId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create, update: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && (resource == null || resource.data.userId == request.auth.uid);
      allow delete: if false;
    }

    match /certificates/{certificateId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.subjectId is string;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
